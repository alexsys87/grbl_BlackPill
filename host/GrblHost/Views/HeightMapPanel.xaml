<UserControl
    x:Class="GrblHost.Views.HeightMapPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <!-- Area and grid -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel IsEnabled="{Binding IsJobRunning, Converter={StaticResource InverseBool}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Map.Area}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Label}" Text="X" />
                            <ui:NumberBox Value="{Binding MapX, Mode=TwoWay}" MaxDecimalPlaces="2" SmallChange="1"
                                          ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Style="{StaticResource Label}" Text="Y" />
                            <ui:NumberBox Value="{Binding MapY, Mode=TwoWay}" MaxDecimalPlaces="2" SmallChange="1"
                                          ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0">
                            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.Map.Width}" />
                            <ui:NumberBox Value="{Binding MapWidth, Mode=TwoWay}" Minimum="1" MaxDecimalPlaces="2" SmallChange="1"
                                          ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.Map.Height}" />
                            <ui:NumberBox Value="{Binding MapHeight, Mode=TwoWay}" Minimum="1" MaxDecimalPlaces="2" SmallChange="1"
                                          ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                    </Grid>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.Map.PointsX}" />
                            <ui:NumberBox Value="{Binding MapPointsX, Mode=TwoWay}" Minimum="2" Maximum="50" MaxDecimalPlaces="0"
                                          SmallChange="1" ClearButtonEnabled="False" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.Map.PointsY}" />
                            <ui:NumberBox Value="{Binding MapPointsY, Mode=TwoWay}" Minimum="2" Maximum="50" MaxDecimalPlaces="0"
                                          SmallChange="1" ClearButtonEnabled="False" SpinButtonPlacementMode="Compact" />
                        </StackPanel>
                        <ui:Button Grid.Column="2" Margin="4,0,0,0" VerticalAlignment="Bottom" HorizontalAlignment="Stretch"
                                   Icon="{ui:SymbolIcon ScaleFill24}" Content="{DynamicResource S.Map.FromProgram}"
                                   Command="{Binding MapFromProgramCommand}" ToolTip="{DynamicResource S.Map.FromProgramTip}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding MapStepText}" />
                </StackPanel>
            </ui:Card>

            <!-- Probing -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Map.Probing}" />
                    <Grid IsEnabled="{Binding IsJobRunning, Converter={StaticResource InverseBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,4,0">
                            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.Map.SafeZ}" />
                            <ui:NumberBox Value="{Binding MapSafeZ, Mode=TwoWay}" Minimum="0.5" Maximum="50" MaxDecimalPlaces="2"
                                          SmallChange="0.5" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="4,0">
                            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.Map.ProbeZ}" />
                            <ui:NumberBox Value="{Binding MapProbeZ, Mode=TwoWay}" Minimum="-50" Maximum="0" MaxDecimalPlaces="2"
                                          SmallChange="0.5" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Margin="4,0,0,0">
                            <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.ProbeFeed}" />
                            <ui:NumberBox Value="{Binding MapFeed, Mode=TwoWay}" Minimum="5" Maximum="1000" MaxDecimalPlaces="0"
                                          SmallChange="10" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                        </StackPanel>
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Primary" Icon="{ui:SymbolIcon ArrowDownload24}"
                                   Content="{DynamicResource S.Map.Probe}" Command="{Binding ProbeMapCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Pause24}" Content="{DynamicResource S.Pause}"
                                   Command="{Binding PauseCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon PlayCircle24}" Content="{DynamicResource S.Resume}"
                                   Command="{Binding ResumeCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Danger" Icon="{ui:SymbolIcon Stop24}"
                                   Content="{DynamicResource S.Stop}" Command="{Binding StopCommand}" />
                    </WrapPanel>
                    <ProgressBar Height="6" Margin="0,4,0,0" Minimum="0" Maximum="100" Value="{Binding JobProgress, Mode=OneWay}"
                                 Visibility="{Binding IsJobRunning, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,6,0,0" FontSize="12" TextWrapping="Wrap" Text="{Binding MapStatus}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Map.ProbeHint}" />
                </StackPanel>
            </ui:Card>

            <!-- Use -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.Map.Use}" />
                    <CheckBox Content="{DynamicResource S.Map.Apply}" IsChecked="{Binding UseHeightMap}" MinWidth="0"
                              IsEnabled="{Binding IsJobRunning, Converter={StaticResource InverseBool}}" />
                    <Grid Margin="0,6,0,0" IsEnabled="{Binding IsJobRunning, Converter={StaticResource InverseBool}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.Map.Segment}" Margin="0,0,6,0" />
                        <ui:NumberBox Grid.Column="1" Value="{Binding MapSegment, Mode=TwoWay}" Minimum="0.1" Maximum="50"
                                      MaxDecimalPlaces="2" SmallChange="0.5" ClearButtonEnabled="False"
                                      SpinButtonPlacementMode="Hidden" />
                        <CheckBox Grid.Column="2" Margin="10,0,0,0" Content="{DynamicResource S.Map.Bicubic}" MinWidth="0"
                                  IsChecked="{Binding MapBicubic}" ToolTip="{DynamicResource S.Map.BicubicTip}" />
                    </Grid>
                    <CheckBox Margin="0,6,0,0" Content="{DynamicResource S.Map.Show}" IsChecked="{Binding ShowHeightMap}" MinWidth="0" />
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon FolderOpen24}" Content="{DynamicResource S.OpenEllipsis}"
                                   Command="{Binding OpenMapCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Save24}" Content="{DynamicResource S.SaveEllipsis}"
                                   Command="{Binding SaveMapCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Delete24}" Content="{DynamicResource S.Map.Clear}"
                                   Command="{Binding ClearMapCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon DocumentArrowDown24}"
                                   Content="{DynamicResource S.Map.SaveLeveled}" Command="{Binding SaveProgramAsCommand}"
                                   CommandParameter="leveled" ToolTip="{DynamicResource S.Map.SaveLeveledTip}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Label}" Margin="0,8,0,2" Text="{DynamicResource S.RecentMaps}"
                               Visibility="{Binding RecentMaps.Count, Converter={StaticResource NullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding RecentMaps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Padding="4,2" Margin="0,1" Appearance="Transparent" HorizontalContentAlignment="Left"
                                           Icon="{ui:SymbolIcon Grid24}" Content="{Binding Name}" ToolTip="{Binding Path}"
                                                    Command="{Binding DataContext.OpenRecentMapCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.Map.UseHint}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
