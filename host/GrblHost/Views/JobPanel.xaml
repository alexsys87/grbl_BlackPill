<UserControl
    x:Class="GrblHost.Views.JobPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
        <StackPanel>
            <!-- File -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.File}" />
                    <TextBlock Text="{Binding FileName}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Visibility="{Binding FileName, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Style="{StaticResource Hint}" Text="{Binding FileInfo}" Margin="0,4,0,4" />
                    <TextBlock Text="{Binding FileWarning}" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,6"
                               Foreground="{DynamicResource LogWarningBrush}"
                               Visibility="{Binding FileWarning, Converter={StaticResource NullToVisibility}}" />
                    <ProgressBar Height="4" Margin="0,0,0,8" Minimum="0" Maximum="100" Value="{Binding LoadProgress, Mode=OneWay}"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    <WrapPanel>
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Secondary"
                                   Icon="{ui:SymbolIcon FolderOpen24}" Content="{DynamicResource S.OpenEllipsis}" Command="{Binding OpenFileCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon ArrowClockwise24}" Content="{DynamicResource S.Reload}"
                                   Command="{Binding ReloadCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon DocumentBulletList24}" Content="{DynamicResource S.DemoProgram}"
                                   Command="{Binding OpenDemoCommand}" ToolTip="{DynamicResource S.DemoTip}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Edit24}" Content="{DynamicResource S.EditProgram}"
                                   Command="{Binding EditProgramCommand}" ToolTip="{DynamicResource S.EditProgramTip}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Save24}" Content="{DynamicResource S.SaveAsEllipsis}"
                                   Command="{Binding SaveProgramAsCommand}" ToolTip="Ctrl+S" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Label}" Margin="0,8,0,2" Text="{DynamicResource S.RecentFiles}"
                               Visibility="{Binding RecentFiles.Count, Converter={StaticResource NullToVisibility}}" />
                    <ItemsControl ItemsSource="{Binding RecentFiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ui:Button Padding="4,2" Margin="0,1" Appearance="Transparent" HorizontalContentAlignment="Left"
                                           Icon="{ui:SymbolIcon Document24}" Content="{Binding Name}" ToolTip="{Binding Path}"
                                           Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding Path}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.DropHint}" />
                </StackPanel>
            </ui:Card>

            <!-- Run -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.RunTitle}" />
                    <WrapPanel>
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Primary" Icon="{ui:SymbolIcon Play24}"
                                   Content="{DynamicResource S.Start}" Command="{Binding StartJobCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon Pause24}" Content="{DynamicResource S.Pause}"
                                   Command="{Binding PauseCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon PlayCircle24}" Content="{DynamicResource S.Resume}"
                                   Command="{Binding ResumeCommand}" />
                        <ui:Button Style="{StaticResource SmallButton}" Appearance="Danger" Icon="{ui:SymbolIcon Stop24}"
                                   Content="{DynamicResource S.Stop}" Command="{Binding StopCommand}" />
                    </WrapPanel>
                    <Grid Margin="0,4,0,0" Visibility="{Binding IsJobRunning, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding JobProgress, Mode=OneWay}" />
                        <TextBlock Grid.Row="1" Margin="0,6,0,0" FontSize="12">
                            <Run Text="{Binding JobProgress, StringFormat={}{0:0.0}%, Mode=OneWay}" FontWeight="SemiBold" />
                            <LineBreak />
                            <Run Text="{DynamicResource S.Elapsed}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding ElapsedText, Mode=OneWay}" />
                            <Run Text="{DynamicResource S.RemainingCap}" Foreground="{DynamicResource TextFillColorTertiaryBrush}" />
                            <Run Text="{Binding RemainingText, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{DynamicResource S.RunHint}" />
                </StackPanel>
            </ui:Card>

            <!-- Start in the middle -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel IsEnabled="{Binding IsJobRunning, Converter={StaticResource InverseBool}}">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.StartFromTitle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource Label}" Text="{DynamicResource S.StartLine}" Margin="0,0,6,0" />
                        <ui:NumberBox Grid.Column="1" Value="{Binding StartLine, Mode=TwoWay}" Minimum="1" MaxDecimalPlaces="0"
                                      SmallChange="1" ClearButtonEnabled="False" SpinButtonPlacementMode="Compact" />
                        <TextBlock Grid.Column="2" Style="{StaticResource Label}" Text="{DynamicResource S.SafeZ}" Margin="10,0,6,0" />
                        <ui:NumberBox Grid.Column="3" Value="{Binding SafeZ, Mode=TwoWay}" Minimum="0" Maximum="100" MaxDecimalPlaces="1"
                                      SmallChange="1" ClearButtonEnabled="False" SpinButtonPlacementMode="Hidden" />
                    </Grid>
                    <WrapPanel Margin="0,8,0,0">
                        <ui:Button Style="{StaticResource SmallButton}" Icon="{ui:SymbolIcon TextBulletListLtr24}"
                                   Content="{DynamicResource S.FromSelectedLine}" Command="{Binding StartFromCurrentLineCommand}" />
                    </WrapPanel>
                    <TextBlock Style="{StaticResource Hint}" Text="{DynamicResource S.StartFromHint}" />
                </StackPanel>
            </ui:Card>

            <!-- Check mode -->
            <ui:Card Style="{StaticResource PanelCard}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.CheckTitle}" />
                    <ui:Button HorizontalAlignment="Left" Icon="{ui:SymbolIcon CheckmarkCircle24}" Content="{DynamicResource S.CheckMode}"
                               Command="{Binding CheckModeCommand}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="{DynamicResource S.CheckHint}" />
                </StackPanel>
            </ui:Card>
        </StackPanel>
    </ScrollViewer>
</UserControl>
